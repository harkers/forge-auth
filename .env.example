# Authentik Environment Variables
# Copy to .env and fill in values

# PostgreSQL Configuration
PG_USER=authentik
PG_PASS=CHANGE_ME_SECURE_PASSWORD
PG_DB=authentik

# Authentik Secret Key (generate with: openssl rand -base64 60)
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# Email Configuration (optional for Phase 1)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_TLS=true
EMAIL_FROM=